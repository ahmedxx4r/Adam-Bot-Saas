# SECURITY: never commit real API keys to this file or anywhere in the repository.
# Keys committed here before were exposed publicly and revoked; generate fresh ones in each provider dashboard.
# Required API credentials
OPENAI_API_KEY=replace-with-your-openai-api-key
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=9SPZl4Mlgwj7QT4gVprb

# Optional model configuration
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional assistant behavior and upload limit
ADAM_SYSTEM_PROMPT=You are Adam, a helpful, natural, concise AI voice assistant. Reply in the same language as the user unless asked otherwise.
MAX_UPLOAD_BYTES=20971520

# Database (SQLite by default; use a PostgreSQL URL in production)
DATABASE_URL=sqlite:///./adam.db

# Authentication (generate a random value of at least 32 characters)
AUTH_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Meta WhatsApp webhook (optional until a Meta app is connected)
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-verification-token

WHATSAPP_ACCESS_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0

# Docker Compose (use a URL-safe random value, e.g. openssl rand -hex 32)
POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret
WORKER_POLL_SECONDS=2
